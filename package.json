{
  "name": "ananta",
  "private": true,
  "version": "0.1.0",
  "description": "Ananta — an open-source, data-driven life simulation game. Live infinite lives across eras.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim": "esbuild sim/lifeSim.ts --bundle --platform=node --format=cjs --outfile=sim/dist/sim.cjs --log-level=warning && node sim/dist/sim.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^6.4.4"
  },
  "license": "MIT"
}
